#  Héritage Intact : variables d'environnement 
# Copier en .env.local. Tout est optionnel en local : sans clé, le site tourne en mode test.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vidéos (Vimeo ou Wistia : jamais YouTube)
NEXT_PUBLIC_VIDEO_PROVIDER=vimeo
NEXT_PUBLIC_VSL_VIDEO_ID=
NEXT_PUBLIC_UPSELL1_VIDEO_ID=
NEXT_PUBLIC_UPSELL2_VIDEO_ID=
NEXT_PUBLIC_MODULE1_VIDEO_ID=
# Les 8 vidéos des étapes de l'espace membre, dans l'ordre, séparées par des
# virgules : la première est l'étape 0. UNE variable au lieu de huit — huit
# noms à saisir sur Vercel, ce sont huit occasions de se tromper, et une vidéo
# absente ne s'affiche pas sans lever la moindre erreur.
# ⚠️ Régler aussi la confidentialité de domaine sur Vimeo (lecture autorisée
# uniquement depuis heritageintact.fr) : l'espace protège la page, pas
# l'identifiant de la vidéo.
NEXT_PUBLIC_ETAPES_VIDEO_IDS=

# Meta Pixel (le pixel ne charge rien tant que vide)
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe : dès que STRIPE_SECRET_KEY est défini, le mode test disparaît
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (remplacera data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM="Héritage Intact <contact@heritageintact.fr>"

# ⚠️ OBLIGATOIRE EN PRODUCTION, et absent de ce fichier jusqu'ici alors qu'il
# existait déjà en local. Le garde de /api/cron/emails est CONDITIONNEL : sans
# cette variable, la route est PUBLIQUE, et n'importe qui peut la déclencher en
# boucle — vider la séquence email de tous les inscrits, et maintenant toucher
# aussi aux accès membres. Un déploiement reconstruit depuis cet exemple partait
# donc grand ouvert, sans le moindre signal.
# Générer une valeur au hasard : openssl rand -hex 32
CRON_SECRET=
