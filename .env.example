#  Héritage Intact : variables d'environnement 
# Copier en .env.local. Tout est optionnel en local : sans clé, le site tourne en mode test.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vidéos (Vimeo ou Wistia : jamais YouTube)
NEXT_PUBLIC_VIDEO_PROVIDER=vimeo
NEXT_PUBLIC_VSL_VIDEO_ID=
NEXT_PUBLIC_UPSELL1_VIDEO_ID=
NEXT_PUBLIC_UPSELL2_VIDEO_ID=
NEXT_PUBLIC_MODULE1_VIDEO_ID=

# Meta Pixel (le pixel ne charge rien tant que vide)
NEXT_PUBLIC_META_PIXEL_ID=

# Stripe : dès que STRIPE_SECRET_KEY est défini, le mode test disparaît
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (remplacera data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails)
RESEND_API_KEY=
EMAIL_FROM="Héritage Intact <contact@heritageintact.fr>"
