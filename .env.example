#  Héritage Intact : variables d'environnement 
# Copier en .env.local. Tout est optionnel en local : sans clé, le site tourne en mode test.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vidéos (Vimeo ou Wistia : jamais YouTube)
NEXT_PUBLIC_VIDEO_PROVIDER=vimeo
NEXT_PUBLIC_VSL_VIDEO_ID=
NEXT_PUBLIC_UPSELL1_VIDEO_ID=
NEXT_PUBLIC_UPSELL2_VIDEO_ID=
NEXT_PUBLIC_MODULE1_VIDEO_ID=
# Les 8 vidéos des étapes de l'espace membre, dans l'ordre, séparées par des
# virgules : la première est l'étape 0. UNE variable au lieu de huit — huit
# noms à saisir sur Vercel, ce sont huit occasions de se tromper, et une vidéo
# absente ne s'affiche pas sans lever la moindre erreur.
# ⚠️ Régler aussi la confidentialité de domaine sur Vimeo (lecture autorisée
# uniquement depuis heritageintact.fr) : l'espace protège la page, pas
# l'identifiant de la vidéo.
NEXT_PUBLIC_ETAPES_VIDEO_IDS=

# Formation V2 : exactement trois identifiants, dans l'ordre V1,V2,V3.
# Les identifiants V1 historiques ci-dessus ne sont pas réutilisés automatiquement.
NEXT_PUBLIC_FORMATION_V2_VIDEO_IDS=
# Activer seulement après correction et validation de la VSL déjà tournée.

# Variables historiques : le Pixel navigateur V5 est neutralisé.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_VALIDEE=false
# Mesure serveur. Activer l'interface en préproduction, puis valider le transport en mode test.
NEXT_PUBLIC_META_SERVER_MEASUREMENT=false
META_CAPI_VALIDEE=false
META_CAPI_MODE=test
META_PIXEL_ID=
META_GRAPH_VERSION=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Pilotage interne : secret distinct du cron, au moins 32 caractères aléatoires.
PILOTAGE_SECRET=
# Connexion serveur Postgres requise pour la preuve de consentement et les journaux.
POSTGRES_URL=
# Compteurs locaux agrégés, sans identifiant visiteur ; à valider avant activation.
NEXT_PUBLIC_FUNNEL_METRICS_ACTIVE=false

# Stripe : dès que STRIPE_SECRET_KEY est défini, le mode test disparaît
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (remplacera data/db.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# N’activer qu’après recette des domaines, consentements et messages réels.
EMAIL_MARKETING_ACTIVE=false
EMAIL_LTV_ACTIVE=false
# Plafond configurable 10–1500 ; au-delà de 150, validation préalable obligatoire.
EMAIL_DAILY_CAP=150
EMAIL_CAPACITY_VALIDATED=false
EMAIL_FROM="Héritage Intact <contact@heritageintact.fr>"

# ⚠️ OBLIGATOIRE EN PRODUCTION, et absent de ce fichier jusqu'ici alors qu'il
# existait déjà en local. Le garde de /api/cron/emails est CONDITIONNEL : sans
# cette variable, la route est PUBLIQUE, et n'importe qui peut la déclencher en
# boucle — vider la séquence email de tous les inscrits, et maintenant toucher
# aussi aux accès membres. Un déploiement reconstruit depuis cet exemple partait
# donc grand ouvert, sans le moindre signal.
# Générer une valeur au hasard : openssl rand -hex 32
CRON_SECRET=

# Lecture des depenses publicitaires (panel /admin/publicite).
# ⚠️ Portee ads_read, distincte de META_CAPI_TOKEN qui ecrit les evenements.
# Sans ces valeurs le panel affiche le chiffre d affaires seul et dit que la
# depense est INCONNUE — jamais nulle.
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
